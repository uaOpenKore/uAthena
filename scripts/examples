/home/process/payment-prod-flower-stop.sh
#!/bin/bash

pid_s=$(ps -ao pid,pgid,cmd | grep "payment" |grep "prod" |grep "start" | grep "flower" |grep -v "testprod" |awk -e '{print $2}')

if [[ "$pid_s" > "0"  ]]
then
 kill -2 -"$pid_s"
fi

rm -f /home/process/payment-flower-prod.pid
