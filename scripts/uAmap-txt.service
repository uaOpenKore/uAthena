[Unit]
Description=uAthena Map TXT server
After=network.target
After=uAchar-txt.target
Requires=uAchar-txt.service
Conflicts=uAlogin.service uAchar.service uAmap.service


[Service]
Type=simple
PIDFile=/opt/uathena/bin/PID-map-txt.pid
WorkingDirectory=/opt/uathena/bin/

User=root
Group=root

OOMScoreAdjust=-500

ExecStart=/opt/uathena/bin/ua-txt-map-start.sh
ExecStop=/opt/uathena/bin/ua-txt-map-stop.sh
ExecReload=/opt/uathena/bin/ua-txt-map-restart.sh
TimeoutSec=300
Restart=always

[Install]
WantedBy=multi-user.target
