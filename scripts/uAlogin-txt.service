[Unit]
Description=uAthena Login-TXT server
After=network.taget
Requires=network.target
Before=uAchar-txt.service uAmap-txt.service
Conflicts=uAlogin.service uAchar.service uAmap.service uAthena.target shutdown.target
PartOf=uAthena-txt.target
ReloadPropagatedFrom=uAthena-txt.target


[Service]
Type=simple
PIDFile=/opt/uathena/bin/PID-login.pid
WorkingDirectory=/opt/uathena/bin/
StandardOutput=/opt/uathena/log/uAlogin-txt.log
StandardError=/opt/uathena/log/uAlogin-txt.log

User=root
Group=root

OOMScoreAdjust=-500

ExecStart=/opt/uathena/bin/ua-start.sh login
ExecStop=/opt/uathena/bin/ua-stop.sh login
ExecReload=/opt/uathena/bin/ua-restart.sh login
TimeoutSec=5
# After ExecStop systemd signals what is left of the unit; the default (control-group) also SIGTERMed the
# supervisor's `perf report` of the run that had just ended (.perf.txt = 2-line banner). Signal only the
# supervisor (it stops its children gracefully) and give the report time; SIGKILL to the group on timeout.
KillMode=mixed
TimeoutStopSec=180
Restart=always

[Install]
WantedBy=uAthena-txt.target
