[Unit]
Description=uAthena Char MySQL server
After=network.target
After=uAlogin.target
Requires=uAlogin.service
Before=uAmap.service
Conflicts=uAlogin-txt.service uAchar-txt.service uAmap-txt.service


[Service]
Type=simple
PIDFile=/opt/uathena/bin/PID-char.pid
WorkingDirectory=/opt/uathena/bin/

User=root
Group=root

OOMScoreAdjust=-500

ExecStart=/opt/uathena/bin/ua-sql-char-start.sh
ExecStop=/opt/uathena/bin/ua-sql-char-stop.sh
ExecReload=/opt/uathena/bin/ua-sql-char-restart.sh
TimeoutSec=300
Restart=always

[Install]
WantedBy=multi-user.target
