[Unit]
Description=uAthena Map MySQL server
After=network.service uAchar.service uAmap.service
Requires=uAchar.service
Conflicts=uAlogin-txt.service uAchar-txt.service uAmap-txt.service uAthena-txt.target
PartOf=uAthena.target


[Service]
Type=simple
PIDFile=/opt/uathena/bin/PID-map.pid
WorkingDirectory=/opt/uathena/bin/

User=root
Group=root

OOMScoreAdjust=-500

ExecStart=/opt/uathena/bin/ua-start.sh map sql
ExecStop=/opt/uathena/bin/ua-stop.sh map
ExecReload=/opt/uathena/bin/ua-restart.sh map sql
TimeoutSec=300
Restart=always

[Install]
WantedBy=multi-user.target
