#!/bin/bash
#
# Network + CPU tuning for the game server on a BARE-METAL HOST (single EPYC
# socket, 32 threads), with NO CPU affinity: numad runs on the host and owns
# NUMA/placement, so this script sets NO manual IRQ/RPS/XPS pinning and no core
# isolation - it would only fight numad and the scheduler. The map-servers also
# launch unpinned (see ua-mapcount.sh, UA_NO_CPU_PIN=1).
#
# Copy to /etc/rc.local on the host, then:
#     chmod +x /etc/rc.local && systemctl enable rc-local
# (systemd has no rc.local by default on Debian; the rc-local shim runs it.)
#
# What is left here is placement-agnostic throughput/latency tuning only:
# NIC multiqueue + offloads, conntrack sizing, socket buffers, CPU governor,
# and the small-write flush. irqbalance stays ON so the kernel spreads NIC
# interrupts across cores on its own.

# --- 0. thread count (for sizing tables/buffers only; no pinning) ----------
T=$(nproc 2>/dev/null || grep -c '^processor' /proc/cpuinfo)

# --- interface (auto-detect default-route NIC; override by editing IFACE) ---
IFACE="${IFACE:-$(ip route show default 2>/dev/null | awk '/default/{print $5; exit}')}"
IFACE="${IFACE:-eth0}"

# --- NIC combined-queue count: min(threads, card maximum) -----------------
# Give the card as many combined queues as it supports (up to the thread count)
# so RX/TX work fans out across cores by itself. Clamp to the hardware ceiling
# from ethtool -l, otherwise ethtool -L fails.
MAXQ=$(ethtool -l "$IFACE" 2>/dev/null | awk '/^Combined:/{print $2; exit}')
case "$MAXQ" in ''|*[!0-9]*) MAXQ="$T";; esac
QUEUES="$T"; [ "$QUEUES" -gt "$MAXQ" ] && QUEUES="$MAXQ"

echo "rc.local: T=$T QUEUES=$QUEUES (max $MAXQ) IFACE=$IFACE (no-affinity / numad host)"

# --- 1. NIC multiqueue + offloads -----------------------------------------
ethtool -L "$IFACE" combined "$QUEUES" 2>/dev/null
ethtool -K "$IFACE" gro on tso on gso on 2>/dev/null

# --- 2. conntrack table ----------------------------------------------------
# The host terminates every game connection, so size conntrack for full load.
CONNTRACK=$(( T * 16384 )); [ "$CONNTRACK" -lt 262144 ] && CONNTRACK=262144
[ -d /sys/module/nf_conntrack ] && echo $((CONNTRACK / 4)) > /sys/module/nf_conntrack/parameters/hashsize 2>/dev/null
sysctl -q -w net.netfilter.nf_conntrack_max=$CONNTRACK 2>/dev/null

# --- 3. socket buffers / backlog (scaled by thread count) -----------------
SOMAXCONN=$(( T * 1024 ));  [ "$SOMAXCONN" -lt 4096 ] && SOMAXCONN=4096
BACKLOG=$(( T * 2000 ));    [ "$BACKLOG"   -lt 5000 ] && BACKLOG=5000
sysctl -q -w net.core.somaxconn=$SOMAXCONN 2>/dev/null
sysctl -q -w net.core.netdev_max_backlog=$BACKLOG 2>/dev/null
sysctl -q -w net.core.rmem_max=16777216 2>/dev/null
sysctl -q -w net.core.wmem_max=16777216 2>/dev/null
sysctl -q -w net.ipv4.tcp_rmem="4096 87380 16777216" 2>/dev/null
sysctl -q -w net.ipv4.tcp_wmem="4096 65536 16777216" 2>/dev/null
sysctl -q -w net.ipv4.tcp_mtu_probing=1 2>/dev/null

# --- 4. CPU governor: performance -----------------------------------------
# The game loop is latency-sensitive: on-demand/schedutil governors down-clock
# semi-idle cores and add ramp-up lag to bursty tick+send() work. Pin every
# core to 'performance'. This is a frequency policy, not a CPU affinity, so it
# coexists fine with numad. Harmless where cpufreq is absent.
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -w "$g" ] && echo performance > "$g" 2>/dev/null
done
# On AMD EPYC with amd-pstate active this keeps turbo/boost enabled.
[ -w /sys/devices/system/cpu/cpufreq/boost ] && \
    echo 1 > /sys/devices/system/cpu/cpufreq/boost 2>/dev/null

# --- 5. send-path latency: flush small map-server writes promptly ----------
# The map servers set TCP_NODELAY in code; tcp_notsent_lowat keeps the kernel
# from buffering tiny movement/action packets, so they leave on the tick that
# produced them (less rubber-banding under load). Cheap, safe.
sysctl -q -w net.ipv4.tcp_notsent_lowat=16384 2>/dev/null

# NOTE: irqbalance is intentionally left ENABLED (not disabled as on the old VM)
# so NIC interrupts are spread automatically; numad handles process/NUMA placement.

tc qdisc show dev "$IFACE"   # boot log: should show 'mq' on a multiqueue card
exit 0
