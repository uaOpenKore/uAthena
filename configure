# Default variables
status_debug="No"
status_cpu="Yes"
status_Os="Yes"
status_mysql="Yes"
status_pcre="Yes"

prefix='/opt/uathena/'
#Don't use a prefix like '/'

# Functions
function check_sed {
	echo -n "Checking for sed... "
	if [ -f $(which sed) ]; then
		echo "yes"
	else
		echo "Error: sed not found in $PATH"
		exit 1
	fi
}

function check_gcc {
	echo -n "Checking for gcc... "
	if [ -f $(which gcc) ]; then
		echo "yes"
	else
		echo "Error: GCC not found in $PATH"
		exit 1
	fi
}

function check_make {
	echo -n "Checking for (g)make... "
	if [ -f $(which make) ]; then
		maker=make
		echo "yes"
	else	if [ -f $(which gmake) ]; then
			maker=gmake
			echo "yes"
			else
			echo "Error: (g)make not found in $PATH"
			exit 1
		fi
	fi
}

function check_sockets {
	echo -n "Checking for sockets... "
	echo "#include <sys/types.h>
#include <sys/socket.h>
#include <netinet/in.h>
int main(){
}" > test_sockets.c
	if $(gcc test_sockets.c -o test_sockets); then
		echo "yes"
		rm -f test_sockets.c test_sockets
	else
		echo "Error: Unix sockets not found/working."
		exit 1
		rm -f test_sockets.c
	fi
}

function check_mysql_headers {
	echo -n "Checking for MySQL headers... "
	if [ -d /usr/lib/mysql ]; then		# Default
		echo "yes"
		mysql_headers_path='/usr/lib/mysql'
	else
		if [ -d /usr/include/mysql ]; then	# Gentoo/Debian/?
			echo "yes"
			mysql_headers_path='/usr/include/mysql'
	else
		echo "Error: MySQL headers not found."
		mysql_headers_path='Not found.'
	fi
	fi
}

function optimize {
	case $@ in
		debug )	status_debug="No" ;;
		cpu )	status_cpu="Yes" ;;
		Os )	status_Os="Yes" ;;
		mysql )	status_mysql="Yes" ;;
		all )	status_debug="No"
			status_cpu="Yes"
			status_Os="Yes"
			status_mysql="Yes" ;;
	esac
}

function make_changes {
	if [ "$maker" != "make" ]; then
		sed -e 's,MAKE = make,MAKE = '$maker',g' Makefile -i
	fi
#	if [ "$status_Os" = "Yes" ]; then
#		sed -e 's,OPT = -O2,OPT = -Os ,g' Makefile -i
#	fi
#	if [ "$status_debug" = "Yes" ]; then
#		sed -e 's,# OPT += -g,OPT += -g ,g' Makefile -i
#	fi
#	if [ "$status_cpu" = "Yes" ]; then
#		sed -e 's,# OPT += -march=generic,OPT += -march=native,g' Makefile -i
#	fi
#	if [ "$status_mysql" = "Yes" ]; then
#		sed -e 's,# OPT += -I/usr/include/mysql -I/usr/include,OPT += -I/usr/include/mysql -I/usr/include,g' Makefile -i
#		sed -e 's,# LIBS += -L/usr/lib/mysql -lmysqlclient,LIBS += -L/usr/lib/mysql -lmysqlclient,g' Makefile -i
#	fi
#	if [ "$status_pcre" = "Yes" ]; then
#		sed -e 's,# OPT += -DPCRE_SUPPORT,OPT += -DPCRE_SUPPORT,g' Makefile -i
#		sed -e 's,# LIBS += -L/usr/lib -lpcre,LIBS += -L/usr/lib -lpcre,g' Makefile -i
#
#	fi
#	if [ "$mysql_headers_path" != "/usr/lib/mysql" ] && [ "$mysql_headers_path" != "Not found." ]; then
#		sed -e 's,LIBS += -L/usr/lib/mysql -lmysqlclient,LIBS += -L'$mysql_headers_path' -lmysqlclient,g' Makefile -i
#	fi
}

function opt_check_pcre {
	echo -n "Checking for PCRE... "
	if [ -f /usr/lib/pcre.h ]; then
		echo "yes"
		status_pcre="Yes"
	else
		echo "Error: PCRE not found.(need pcre-devel)"
		status_pcre="No"
	fi
}

function make_report {
	echo "Configuration report:"
	echo uAthena

	echo
	echo Enable PCRE support...... : $status_pcre
	echo
	echo Enable debug optimization : $status_debug
	echo Enable cpu optimization.. : $status_cpu
	echo Enable Os optimization... : $status_Os
	echo Enable MySQL optimization : $status_mysql
	echo
	echo MySQL headers path....... : $mysql_headers_path
	echo
	echo uAthena will be installed in $prefix
	echo Please type \'make\' and \'make sql\' now to compile uAthena.
	echo -e ""
	echo Attention:
	echo For the initial installation, use \'make install\'.
	echo After subsequent compilations, use \'make update\'
	echo to update executable files in the $prefix directory..
	echo "!!!"
	echo "	Default is /opt/uathena/ (DON\'T CHANGE IT!!!)"
	echo "	Use ./configure && make - use for building source code."
	echo "	make install - use only for the initial installation of uAthena!"
	echo "	make update - for subsequent updates of uAthena!!!"
	echo "	make backup - deletes the previous backup and creates a new one (sql & txt)."
	echo "	make uninstall - will perform a backup and remove the entire current projec."
	echo "	make erase - performs make uninstall and deletes backups."
	echo "	make clean - clears the source directory of build files."
}

function helptext {
	echo "uAthena Configure Script version 0.1"
	echo
	echo "Options:"
	echo
	echo "	-h	Display this help message and exit."
	echo "		Default is /opt/uathena/ (DON\'T CHANGE IT!!!)"
	echo "		Use ./configure && make - use for building source code."
	echo "		make install - use only for the initial installation of uAthena!"
	echo "		make update - for subsequent updates of uAthena!!!"
	echo "		make backup - deletes the previous backup and creates a new one (sql & txt)."
	echo "		make uninstall - will perform a backup and remove the entire current projec."
	echo "		make erase - performs make uninstall and deletes backups."
	echo "		make clean - clears the source directory of build files."

	echo
#	echo "Report bugs (about the configure script) to dontBR at the uAthena Support Board."
}

function make_installable {
echo -e ''														>> Makefile
echo -e 'install:'												>> Makefile
echo -e '		$(shell mkdir -p '$prefix'bin/log/)'			>> Makefile
echo -e '		$(shell mkdir -p '$prefix'backup/)'				>> Makefile
echo -e '		$(shell cp -r dumps '$prefix')'					>> Makefile
echo -e '		$(shell cp -r save  '$prefix')'					>> Makefile
echo -e '		$(shell cp -r db    '$prefix')'					>> Makefile
echo -e '		$(shell cp -r conf  '$prefix')'					>> Makefile
echo -e '		$(shell cp -r npc   '$prefix')'					>> Makefile
echo -e '		$(shell cp *-server* '$prefix'bin/)'			>> Makefile
echo -e '		$(shell ln -s '$prefix'save/    '$prefix'bin/)'	>> Makefile
echo -e '		$(shell ln -s '$prefix'db/      '$prefix'bin/)'	>> Makefile
echo -e '		$(shell ln -s '$prefix'conf/    '$prefix'bin/)'	>> Makefile
echo -e '		$(shell ln -s '$prefix'npc/     '$prefix'bin/)'	>> Makefile
echo -e '		$(shell ln -s '$prefix'bin/log/ '$prefix')'		>> Makefile
echo -e '		$(shell cp scripts/uA* /etc/systemd/system/)'	>> Makefile
echo -e '		$(shell systemctl daemon-reload)'
echo -e '		$(shell cp scripts/ua-*.sh '$prefix'bin/)'		>> Makefile
echo -e ''												>> Makefile
echo -e 'uninstall:'									>> Makefile
echo -e '		$(shell rm -fr '$prefix'bin)'			>> Makefile
echo -e '		$(shell rm -fr '$prefix'db)'			>> Makefile
echo -e '		$(shell rm -fr '$prefix'conf)'			>> Makefile
echo -e '		$(shell rm -fr '$prefix'npc)'			>> Makefile
echo -e '		$(shell rm -fr '$prefix'bin)'			>> Makefile
echo -e '		$(shell rm -fr '$prefix'save)'			>> Makefile
echo -e '		$(shell rm -fr '$prefix'dumps)'			>> Makefile
echo -e '		$(shell rm -f  '$prefix'log)'			>> Makefile
echo -e '		$(shell rm -f /etc/systemd/system/uA*)'	>> Makefile
echo -e '		$(shell systemctl daemon-reload)'
echo -e ''									>> Makefile
echo -e 'erase:'							>> Makefile
echo -e '		$(shell rm -rf '$prefix')' 	>> Makefile
echo -e ''																		>> Makefile
echo -e 'backup:'																>> Makefile
echo -e '		$(shell rm -rf  '$prefix'backup/*)'								>> Makefile
echo -e '		$(shell /opt/uathena/dumps/dumps.sh backup)'					>> Makefile
echo -e '		$(shell cp -r /opt/uathena/save /opt/uathena/backup/)'			>> Makefile
echo -e '		$(shell cp /opt/uathena/dumps/backup/* /opt/uathena/backup/)'	>> Makefile
echo -e ''														>> Makefile
echo -e 'update:'												>> Makefile
echo -e '		INFO: >>> Stopping Athena'
echo -e '		$(shell systemctl stop uAthena.target uAthena-txt.target)'
echo -e '		INFO: >>> Creating a backup'
echo -e '		INFO: >>> Apply migrations'
echo -e '		$(shell /opt/uathena/dumps/dumps.sh migrations)'>> Makefile
echo -e '		INFO: >>> Updating files'
echo -e '		$(shell cp *-server* '$prefix'bin/)'			>> Makefile
echo -e '		>>> The update process is complete.'
echo -e '		>>> If there were no critical error messages,'
echo -e '		>>> then start the server:'
echo -e '		SQL: systemctl start uAthena.target'
echo -e '		>>> or'
echo -e '		TXT: systemctl start uAthena-txt.target'
}


# Arguments
while getopts ":hdo:ep:" opt; do
	case $opt in
		h )	helptext ; exit ;;
		d )	set -x ;;
		o ) 	optimize ${OPTARG} ;;
		e )	opt_check_pcre ;;
		p )	prefix=${OPTARG} ; [ -d ${OPTARG} ] || echo "The directory $prefix does not exist. Creating...";;
	esac
done


# Execution
echo "uAthena configure script"
echo "Note: This is ALPHA software! Do NOT use it on a production server!"
echo
echo "Checking for dependencies.."
check_sed
check_gcc
check_make
check_sockets
check_mysql_headers
make_changes
make_installable
echo
make_report
exit
