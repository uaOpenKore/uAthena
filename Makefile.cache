CC="gcc -pipe" CFLAGS="-Os -g3 -rdynamic -fomit-frame-pointer -DCHRIF_OLDINFO -DBCHECK -ffast-math -fcommon -march=native -mtune=native -Wall -Wno-sign-compare -Wno-unused-parameter -Wno-pointer-sign -Wno-switch -DHAVE_SETRLIMIT -Wno-unused -Wno-parentheses -fstack-protector -DPCRE_SUPPORT -I../common -I/usr/include -I/usr/include/mysql -DMAPREGSQL  -I/usr/include/mariadb -I/usr/include/mariadb/mysql -m32" LIB_S="-L/usr/lib64 -L/usr/lib -L/usr/lib32 -L/usr/libx32 -lpcre -L/usr/lib64/mysql -L/usr/lib/mysql  -lmysqlclient -ldl -L/usr/lib/i386-linux-gnu/ -lmariadb -lz -lm -m32"